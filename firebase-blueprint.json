{
  "entities": {
    "User": {
      "collection": "users",
      "path": "users/{userId}",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "isPro": { "type": "boolean" },
        "creditsRemaining": { "type": "number" },
        "maxDailyCredits": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    },
    "Creation": {
      "collection": "creations",
      "path": "users/{userId}/creations/{creationId}",
      "fields": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "contentType": { "type": "string" },
        "content": { "type": "string" },
        "wordCount": { "type": "number" },
        "dateFormatted": { "type": "string" },

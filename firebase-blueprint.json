        "isFavorite": { "type": "boolean" },
        "subtitle": { "type": "string" },
        "tags": { "type": "string" }
      }
    },
    "Template": {
      "collection": "templates",
      "path": "templates/{templateId}",
      "fields": {
        "id": { "type": "string" },

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="170dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_card_high"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_tag_pill">

        <ImageView
            android:id="@+id/iv_tool_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_smart_display"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_tool_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="YouTube Script"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_tool_desc"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Create engaging, retention-optimized video scripts."
        android:textColor="@color/on_surface_variant"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tool_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start drafting"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/primary" />
    </LinearLayout>
</LinearLayout>

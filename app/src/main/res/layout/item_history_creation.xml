<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_high"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Icon, Title, Subtitle, Star & More -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/layout_history_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tag_pill">

            <ImageView
                android:id="@+id/iv_history_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_smart_display"
                app:tint="@color/primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_history_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="YouTube Tech Review: Flagship 2025"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_history_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="YouTube Script • 1,240 words • Oct 24"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Star / Favorite button -->
        <ImageView
            android:id="@+id/btn_history_star"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Favorite"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_star_filled" />

        <!-- 3-dots option menu -->
        <ImageView
            android:id="@+id/btn_history_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="More"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/outline" />
    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_history_tag_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="v2.4 Edited"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_card_copy"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_tag_pill"
                android:drawableStart="@drawable/ic_content_copy"
                android:drawablePadding="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Copy"
                android:textAllCaps="false"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_card_view"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_pill"
                android:drawableStart="@drawable/ic_visibility"
                android:drawablePadding="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="View"
                android:textAllCaps="false"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_card_share"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_pill"
                android:drawableStart="@drawable/ic_share"
                android:drawablePadding="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Share"
                android:textAllCaps="false"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
